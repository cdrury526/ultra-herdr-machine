#!/usr/bin/env bash
# Block push if any commit being pushed touches files over the line limit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/scripts/check-file-length.sh"
failed=0

push_range() {
  local local_sha="$1"
  local remote_sha="$2"

  if [[ "$remote_sha" != 0000000000000000000000000000000000000000 ]]; then
    echo "${remote_sha}..${local_sha}"
    return
  fi

  local base=""
  if upstream="$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null)"; then
    base="$(git merge-base "$local_sha" "$upstream" 2>/dev/null || true)"
  fi
  if [[ -z "$base" ]]; then
    for ref in main master origin/main origin/master; do
      if git rev-parse --verify "$ref" >/dev/null 2>&1; then
        base="$(git merge-base "$local_sha" "$ref" 2>/dev/null || true)"
        [[ -n "$base" ]] && break
      fi
    done
  fi

  if [[ -n "$base" ]]; then
    echo "${base}..${local_sha}"
  else
    echo "$local_sha"
  fi
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [[ "$local_sha" == 0000000000000000000000000000000000000000 ]]; then
    continue
  fi

  range="$(push_range "$local_sha" "$remote_sha")"
  if ! "$CHECK" --rev "$range"; then
    failed=1
  fi
done

exit "$failed"
